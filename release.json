{
  "schema_version": 1,
  "app": "pbb-realtime",
  "name": "PBB Realtime",
  "display_name": "Realtime",
  "milestone": 1,
  "version": "1.0.0",
  "display_version": "v1-1.0.0",
  "build": {
    "version": "1.0.0",
    "id": null,
    "built_at": null,
    "git_commit": null,
    "builder": null
  },
  "release_date": "2026-05-15",
  "release_name": "Kit Setup Installer Contract",
  "type": "laravel",
  "repository": {
    "type": "github",
    "owner": "jybanez",
    "repo": "realtime.pbb.ph",
    "url": "https://github.com/jybanez/realtime.pbb.ph"
  },
  "updates": {
    "source": "github-releases",
    "channel": "testing"
  },
  "update": {
    "contract_version": 1,
    "channel": "testing",
    "immutable_release": false,
    "from_versions": ["1.0.0"],
    "compatibility": "same-version-rebuild",
    "requires_database_migration": true,
    "requires_data_prep_rerun": true,
    "requires_service_restart": true,
    "rollback_supported": false,
    "database_migration": {
      "policy": "additive",
      "summary": "Adds Account identity/status columns to users and applies Realtime queue dispatch indexes where missing.",
      "tables": {
        "users": ["pbb_user_id", "status"],
        "realtime_media_chunks": ["status_id index"],
        "realtime_server_events": ["status_id index"]
      }
    }
  },
  "requires": {
    "os": ["windows", "linux"],
    "php": ">=8.1",
    "php_extensions": ["json", "openssl", "mbstring", "fileinfo", "zip", "pdo", "pdo_mysql"],
    "mysql": ">=5.7",
    "node": "not-required-assets-built",
    "composer": "not-required-vendor-bundled",
    "apps": {
      "pbb-maestro": "optional-for-telemetry",
      "pbb-account": "optional-for-sso-and-app-admin"
    }
  },
  "landing": {
    "launcher": {
      "logo_kind": "mark",
      "icon": "radio-tower",
      "primary_launch_url": "https://realtime.pbb.ph/admin",
      "audience": ["admin", "operator"]
    },
    "public_gateway": {
      "enabled": false
    }
  },
  "account": {
    "sso": {
      "enabled_by_default": false,
      "client_id": "pbb-realtime",
      "base_url": "https://realtime.pbb.ph",
      "redirect_uri": "https://realtime.pbb.ph/auth/account/callback",
      "post_logout_redirect_uri": "https://realtime.pbb.ph",
      "scopes": ["openid", "profile"],
      "settings_store": "realtime_runtime_settings",
      "settings_ui": "admin navbar Realtime settings modal",
      "settings": {
        "enabled": "account_sso_enabled",
        "base_url": "account_sso_base_url",
        "client_id": "account_sso_client_id",
        "client_secret": "account_sso_client_secret",
        "redirect_uri": "account_sso_redirect_uri",
        "post_logout_redirect_uri": "account_sso_post_logout_redirect_uri",
        "scopes": "account_sso_scopes",
        "timeout_seconds": "account_sso_timeout_seconds",
        "ca_bundle": "account_sso_ca_bundle"
      }
    },
    "app_admin": {
      "enabled_by_default": false,
      "base_url": "https://realtime.pbb.ph",
      "settings_store": "realtime_runtime_settings",
      "settings_ui": "admin navbar Realtime settings modal",
      "settings": {
        "enabled": "account_admin_api_enabled",
        "token": "account_admin_api_token",
        "client": "account_admin_api_client"
      },
      "expected_client_header": "pbb-account",
      "routes": {
        "meta": "/api/account-admin/meta",
        "lookup": "/api/account-admin/users/{pbb_user_id}",
        "provision": "/api/account-admin/users/{pbb_user_id}",
        "remove": "/api/account-admin/users/{pbb_user_id}",
        "role": "/api/account-admin/users/{pbb_user_id}/role",
        "status": "/api/account-admin/users/{pbb_user_id}/status"
      },
      "roles": ["admin", "regular"],
      "statuses": ["active", "disabled"],
      "capabilities": {
        "removeUser": true
      },
      "notes": "user_type is the Account-managed Realtime role. is_operator is a local admin-surface access capability, not an Account role. Remove Access unlinks pbb_user_id, disables login, and preserves local history. App-admin runtime auth reads DB settings only."
    }
  },
  "installer": {
    "interactive": "public/installer/index.php",
    "unattended": "installer/install-run.php",
    "status": "installer/status.php",
    "schema": "installer/schema/install.schema.json",
    "database": {
      "fresh_install_strategy": "baseline_schema",
      "baseline_schema": {
        "path": "database/schema/mysql-schema.sql",
        "engine": "mysql",
        "generated_at": "2026-06-30T16:48:14.4753286Z",
        "source": "current-release-schema"
      },
      "upgrade_strategy": "laravel_migrations",
      "historical_migrations": "retained for development and bounded upgrade/repair paths"
    },
    "tools": {
      "populate_initial_data": {
        "path": "tools/populate-initial-data.php",
        "description": "Populate Realtime clients, project scopes, policies, media/query settings, and backend ingress secrets.",
        "config_section": "realtime.populate",
        "default_source": "resources/data/realtime/hotline-client-data.json",
        "required": false
      }
    }
  },
  "data_prep": {
    "version": 1,
    "capabilities": {
      "prepare_data": true,
      "apply_settings": true,
      "verify": true
    },
    "tools": {
      "prepare_data": {
        "path": "tools/populate-initial-data.php",
        "config_section": "realtime.populate",
        "default_source": "resources/data/realtime/hotline-client-data.json",
        "description": "Prepare packaged PBB Realtime client profiles, policies, and project scopes for Hotline and Support."
      },
      "apply_settings": {
        "path": "tools/data-prep/apply-settings.php",
        "config_section": "realtime.data_prep.apply_settings",
        "description": "Apply Realtime runtime settings supplied by Kit Data Prep, including Maestro telemetry settings."
      },
      "verify": {
        "path": "tools/data-prep/verify.php",
        "config_section": "realtime.data_prep.verify",
        "default_source": "resources/data/realtime/hotline-client-data.json",
        "description": "Verify packaged PBB Realtime client profiles, policies, and project scopes for Hotline and Support."
      }
    }
  },
  "health": {
    "http": "/api/health",
    "ready": "/api/ready",
    "metrics": "/api/metrics"
  },
  "web_server": {
    "owner": "kit-setup",
    "requirements": [
      {
        "id": "pbb-realtime-laravel-bootstrap-env",
        "kind": "apache_setenv",
        "scope": "vhost",
        "keys": [
          { "name": "APP_NAME", "value_source": "app.name", "required": true, "secret": false },
          { "name": "APP_ENV", "value_source": "app.env", "required": true, "secret": false },
          { "name": "APP_DEBUG", "value_source": "app.debug", "required": true, "secret": false },
          { "name": "APP_URL", "value_source": "app.url", "required": true, "secret": false },
          { "name": "APP_KEY", "value_source": "generated_config.APP_KEY", "required": true, "secret": true },
          { "name": "DB_CONNECTION", "value_source": "database.connection", "required": true, "secret": false },
          { "name": "DB_HOST", "value_source": "database.host", "required": true, "secret": false },
          { "name": "DB_PORT", "value_source": "database.port", "required": true, "secret": false },
          { "name": "DB_DATABASE", "value_source": "database.database", "required": true, "secret": false },
          { "name": "DB_USERNAME", "value_source": "database.username", "required": true, "secret": false },
          { "name": "DB_PASSWORD", "value_source": "database.password", "required": false, "secret": true },
          { "name": "SESSION_DRIVER", "value": "file", "required": true, "secret": false },
          { "name": "SESSION_COOKIE", "value_source": "app.session_cookie", "required": true, "secret": false },
          { "name": "CACHE_STORE", "value": "file", "required": true, "secret": false },
          { "name": "QUEUE_CONNECTION", "value": "sync", "required": true, "secret": false },
          { "name": "FILESYSTEM_DISK", "value_source": "app.filesystem_disk", "required": true, "secret": false },
          { "name": "PBB_CA_BUNDLE", "value_source": "runtime.pbb_ca_bundle", "required": false, "secret": false }
        ]
      },
      {
        "id": "pbb-realtime-websocket-proxy",
        "type": "websocket_proxy",
        "server_path": "/realtime",
        "path_prefix": "/realtime",
        "upstream_url": "ws://127.0.0.1:8080/realtime",
        "required_modules": ["proxy", "proxy_wstunnel"],
        "headers": {
          "Upgrade": "$http_upgrade",
          "Connection": "upgrade"
        },
        "directives": {
          "ProxyWebsocketFallbackToProxyHttp": "Off"
        },
        "set_env": {},
        "smoke_test": {
          "auth_required": false,
          "path": "/realtime",
          "query": {},
          "headers": {
            "Host": "{app.host}",
            "Origin": "{app.url}"
          },
          "expect_status": 101,
          "expect_first_message_type": "session.awaiting-auth"
        },
        "install_blocking": false,
        "smoke_test_phase": "post-vhost",
        "notes": "Kit Setup owns final Apache/Nginx include rendering, guarded apply, config test, and public websocket smoke test."
      }
    ]
  },
  "runtime_services": [
    {
      "id": "pbb-realtime-websocket",
      "name": "PBB Realtime WebSocket",
      "type": "background_process",
      "required": true,
      "required_for_smoke": true,
      "manager": "kit",
      "working_directory": "{app.install_path}",
      "command": "{runtime.php_binary}",
      "args": ["artisan", "realtime:serve"],
      "env": {
        "REALTIME_WS_PUBLIC_HOST": "{app.host}",
        "REALTIME_EMBEDDED_MEDIA_CHUNK_DISPATCH_ENABLED": "false"
      },
      "health_check": {
        "type": "tcp",
        "host": "127.0.0.1",
        "port": 8080,
        "timeout_seconds": 3
      },
      "logs": {
        "stdout": "storage/logs/pbb-realtime-websocket.out.log",
        "stderr": "storage/logs/pbb-realtime-websocket.err.log"
      },
      "notes": "Kit starts and verifies this before public websocket smoke checks."
    },
    {
      "id": "pbb-realtime-media-dispatcher",
      "name": "PBB Realtime Media Dispatcher",
      "type": "background_process",
      "required": true,
      "required_for_smoke": false,
      "manager": "kit",
      "working_directory": "{app.install_path}",
      "command": "{runtime.php_binary}",
      "args": ["artisan", "realtime:dispatch"],
      "health_check": {
        "type": "process",
        "timeout_seconds": 3
      },
      "logs": {
        "stdout": "storage/logs/pbb-realtime-media-dispatcher.out.log",
        "stderr": "storage/logs/pbb-realtime-media-dispatcher.err.log"
      },
      "notes": "Kit starts this alongside the websocket daemon when embedded media chunk dispatch is disabled."
    }
  ],
  "services": [
    {
      "id": "pbb-realtime-websocket",
      "name": "PBB Realtime WebSocket",
      "kind": "daemon",
      "command": "php artisan realtime:serve",
      "required": true,
      "healthcheck": "/api/metrics"
    },
    {
      "id": "pbb-realtime-media-dispatcher",
      "name": "PBB Realtime Media Dispatcher",
      "kind": "worker",
      "command": "php artisan realtime:dispatch",
      "required": false,
      "healthcheck": "maestro:realtime"
    }
  ],
  "artifacts": {
    "install_manifest": "storage/app/installer/install-manifest.json",
    "install_report": "storage/app/installer/install-report.json",
    "install_log": "storage/app/installer/install.log"
  }
}
