APP_NAME="PBB Realtime"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pbb_realtime
DB_USERNAME=root
DB_PASSWORD=

REALTIME_SESSION_DRIVER=file
REALTIME_SESSION_LIFETIME=15
REALTIME_SESSION_COOKIE=pbb_realtime_session
REALTIME_SESSION_DOMAIN=

REALTIME_SERVICE_NAME="PBB Realtime"
REALTIME_TOKEN_AUDIENCE=pbb-realtime
REALTIME_TOKEN_SIGNING_SECRET=
REALTIME_TRUSTED_ISSUERS=local.pbb.test
REALTIME_PUBLIC_WEBSOCKET_URL=ws://localhost:8080/realtime
REALTIME_WS_PUBLIC_HOST=localhost
REALTIME_WS_BIND_ADDRESS=127.0.0.1
REALTIME_WS_HOST=127.0.0.1
REALTIME_WS_PORT=8080
REALTIME_ALLOWED_ORIGINS=
REALTIME_MESSAGE_RATE_LIMIT_PER_MINUTE=120
REALTIME_ROOM_JOIN_RATE_LIMIT_PER_MINUTE=30
REALTIME_EVENT_PUBLISH_RATE_LIMIT_PER_MINUTE=60
REALTIME_EVENT_PUBLISH_PAYLOAD_MAX_BYTES=32768
REALTIME_MAX_ROOMS_PER_SESSION=50
REALTIME_TOKEN_TTL_MINUTES=15
REALTIME_HEARTBEAT_INTERVAL_SECONDS=30
REALTIME_PRESENCE_STALE_SECONDS=90
REALTIME_USAGE_TELEMETRY_RETENTION_DAYS=90

REALTIME_EVENT_PUBLISH_TRACE=false
REALTIME_EVENT_PUBLISH_DRAIN_INTERVAL_SECONDS=1
REALTIME_EVENT_PUBLISH_DRAIN_BATCH_SIZE=100
REALTIME_EMBEDDED_MEDIA_CHUNK_DISPATCH_ENABLED=true
REALTIME_MEDIA_CHUNK_DISPATCH_BATCH_SIZE=25
REALTIME_MEDIA_CHUNK_DISPATCH_CLAIM_TIMEOUT_SECONDS=300
REALTIME_BACKEND_INGRESS_SECRET_PEPPER=
REALTIME_SANDBOX_MAX_ATTACHMENT_COUNT=6
REALTIME_SANDBOX_MAX_ATTACHMENT_BYTES=2097152
REALTIME_SANDBOX_MAX_TOTAL_ATTACHMENT_BYTES=6291456
REALTIME_SANDBOX_ATTACHMENT_CHUNK_EVENTS_PER_MINUTE=480
REALTIME_SANDBOX_ATTACHMENT_CHUNK_BYTES_PER_MINUTE=12582912

MAESTRO_TELEMETRY_ENABLED=false
MAESTRO_BASE_URL=
MAESTRO_TELEMETRY_LOCAL_BYPASS_ENABLED=false
MAESTRO_TELEMETRY_LOCAL_BYPASS_BASE_URL=http://127.0.0.1
MAESTRO_TELEMETRY_LOCAL_BYPASS_HOST=maestro.pbb.ph
MAESTRO_TELEMETRY_TOKEN=
MAESTRO_TELEMETRY_TOKEN_HEADER=X-Telemetry-Token
MAESTRO_TELEMETRY_APP_CODE=realtime
MAESTRO_TELEMETRY_HEARTBEAT_SECONDS=15
MAESTRO_TELEMETRY_CONNECT_TIMEOUT_SECONDS=3
MAESTRO_TELEMETRY_TIMEOUT_SECONDS=5
MAESTRO_TELEMETRY_VERIFY_TLS=true

BROADCAST_DRIVER=log
CACHE_STORE=file
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=15

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
