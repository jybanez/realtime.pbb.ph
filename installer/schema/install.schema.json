{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realtime.pbb.ph/installer/schema/install.schema.json",
  "title": "PBB Realtime installer config",
  "type": "object",
  "required": ["mode", "app", "database", "realtime", "admin"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "type": "string",
      "enum": ["fresh", "upgrade", "repair", "preflight"]
    },
    "kit": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "run_id": { "type": "string" },
        "node_id": { "type": "string" },
        "operator": { "type": "string" },
        "timezone": { "type": "string" }
      }
    },
    "app": {
      "type": "object",
      "required": ["install_path", "app_url"],
      "additionalProperties": true,
      "properties": {
        "install_path": { "type": "string", "minLength": 1 },
        "public_path": { "type": "string" },
        "app_url": { "type": "string", "format": "uri" },
        "app_env": { "type": "string" },
        "app_debug": { "type": "boolean" },
        "run_seeders": {
          "type": "boolean",
          "description": "Deprecated for Kit bundles. Database seeders are source-only; use installer.tools.populate_initial_data for Data Prep."
        },
        "seed_command": {
          "type": "string",
          "description": "Deprecated for Kit bundles. Database seeders are source-only; use installer.tools.populate_initial_data for Data Prep."
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["host", "database", "username"],
      "additionalProperties": true,
      "properties": {
        "driver": { "type": "string", "enum": ["mysql"] },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "database": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "password": { "type": "string" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mysql_binary": {
          "type": "string",
          "description": "Absolute mysql.exe or mysql client path selected by Kit Setup for baseline schema loading."
        }
      }
    },
    "realtime": {
      "type": "object",
      "required": ["service_name", "token_audience", "token_signing_secret", "trusted_issuers", "public_websocket_url", "ws_bind_address", "ws_port"],
      "additionalProperties": true,
      "properties": {
        "service_name": { "type": "string", "minLength": 1 },
        "token_audience": { "type": "string", "minLength": 1 },
        "token_signing_secret": { "type": "string", "minLength": 8 },
        "trusted_issuers": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
          ]
        },
        "public_websocket_url": { "type": "string", "format": "uri" },
        "ws_bind_address": { "type": "string", "minLength": 1 },
        "ws_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "allowed_origins": {
          "description": "Legacy/metadata setting only. Ratchet route-level origin filtering is disabled; browser access is governed by token admission and Realtime client/project policy.",
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "embedded_media_chunk_dispatch_enabled": {
          "type": "boolean",
          "description": "Set false for Kit-managed installs so Kit starts realtime:dispatch as a separate runtime service."
        },
        "populate": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "source": {
              "type": "string",
              "description": "Optional JSON source path. Defaults to resources/data/realtime/hotline-client-data.json when no explicit source or clients array is supplied."
            },
            "clients": {
              "type": "array",
              "items": { "type": "object" }
            },
            "options": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "overwrite_secrets": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "admin": {
      "type": "object",
      "required": ["name", "email", "password"],
      "additionalProperties": true,
      "properties": {
        "strategy": { "type": "string", "enum": ["create_if_missing"] },
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "password": { "type": "string", "minLength": 10 },
        "must_change_password": { "type": "boolean" },
        "overwrite_existing": { "type": "boolean" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "target_os": { "type": "string", "enum": ["windows", "linux"] },
        "service_manager": { "type": "string", "enum": ["windows-service", "scheduled-task", "systemd"] },
        "startup_mode": { "type": "string", "enum": ["automatic", "manual"] },
        "registration_mode": { "type": "string", "enum": ["template", "register", "generate", "manual"] },
        "allow_existing_install": { "type": "boolean" }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "target_os": { "type": "string", "enum": ["windows", "linux"] },
        "manager": { "type": "string", "enum": ["windows-service", "scheduled-task", "systemd"] },
        "startup_mode": { "type": "string", "enum": ["automatic", "manual"] },
        "registration_mode": { "type": "string", "enum": ["generate", "register", "manual", "template"] }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "maestro": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "base_url": { "type": "string" },
            "app_code": { "type": "string" },
            "telemetry_token": { "type": "string" }
          }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "run_migrations": { "type": "boolean" },
        "database_setup": {
          "type": "string",
          "enum": ["baseline_schema"],
          "description": "Kit-provided fresh install database setup strategy. Realtime fresh installs use the packaged baseline schema."
        },
        "seed_initial_data": {
          "type": "boolean",
          "description": "Deprecated for core install. Kit Setup handles optional data preparation through release.json installer.tools."
        },
        "write_env": { "type": "boolean" },
        "cache_config": { "type": "boolean" },
        "validate_after_install": { "type": "boolean" }
      }
    }
  }
}
